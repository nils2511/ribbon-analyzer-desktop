# Publish only the explicitly selected source, documentation and tests below.
# Everything else stays local, including research data, credentials and backups.
*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CITATION.cff
!/requirements.txt
!/ribbon_analyzer.py
!/evaluate_detector.py
!/setup.sh
!/setup_windows.bat
!/start.sh
!/start.bat
!/src/
/src/*
!/src/*.py
!/tests/
/tests/*
!/tests/test_*.py
!/examples/
/examples/*
!/examples/create_demo.py
!/scripts/
/scripts/*
!/scripts/check_release.py
!/docs/
/docs/*
!/docs/USAGE.md
!/docs/RELEASE.md
!/docs/REPOSITORY.md
!/docs/manual-annotation.png
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml
!/.github/dependabot.yml
